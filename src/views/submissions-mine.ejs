<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>คำร้องของฉัน</title>
</head>
<body>
  <h1>คำร้องของฉัน</h1>
  <p><a href="/memo/new">+ สร้าง MEMO ใหม่</a></p>
  <ul>
    <% submissions.forEach(function (s) { %>
      <li>
        <% if (s.status === 'draft') { %>
          <a href="/memo/<%= s._id %>/edit"><%= s.values.subject || '(ยังไม่มีชื่อเรื่อง)' %></a>
          — ร่าง — แก้ไขล่าสุด <%= s.updatedAt.toLocaleString('th-TH') %>
        <% } else { %>
          <a href="/memo/<%= s._id %>/view"><%= s.docNumber %> — <%= s.values.subject %></a>
          — สถานะ: <%= STATUS_LABEL[s.status] %>
        <% } %>
      </li>
    <% }) %>
    <% if (submissions.length === 0) { %>
      <li>ยังไม่มีคำร้อง</li>
    <% } %>
  </ul>
</body>
</html>