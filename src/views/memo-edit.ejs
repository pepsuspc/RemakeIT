<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>MEMO ขออนุมัติ</title>
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/a4.css">
</head>
<body>
  <% var errs = typeof errors === 'undefined' ? {} : errors; %>

  <div class="a4-toolbar no-print">
    <button type="button" id="btn-save">บันทึกร่าง</button>
    <span id="save-status"></span>
    <button type="submit" form="memo-form" formaction="/memo/<%= draft._id %>/submit" formmethod="POST">ส่ง</button>
  </div>

  <% if (Object.keys(errs).length > 0) { %>
    <div class="a4-error-summary no-print">กรุณาตรวจสอบ <%= Object.keys(errs).length %> ช่องที่ยังไม่ได้กรอก</div>
  <% } %>

  <form id="memo-form" data-submission-id="<%= draft._id %>">
  <div class="a4-page-wrap">
    <div class="a4-page">

      <div class="a4-title-bar">
        <div></div>
        <div class="a4-form-title">MEMO ขออนุมัติ</div>
        <div class="a4-doc-number">(ยังไม่มีเลขที่)</div>
      </div>

      <div class="a4-grid">

        <div class="a4-field" style="grid-column: 17 / span 8;">
          <label class="a4-field-label">วันที่</label>
          <div class="a4-value a4-align-right">(จะเติมอัตโนมัติตอนส่ง)</div>
        </div>

        <div class="a4-field" style="grid-column: 1 / span 24;">
          <label class="a4-field-label" for="f-subject">
            เรื่อง <span class="a4-required">*</span>
          </label>
          <input class="a4-input" type="text" id="f-subject" name="values[subject]" maxlength="200" required value="<%= draft.values.subject || '' %>">
          <% if (errs.subject) { %><div class="a4-field-error"><%= errs.subject %></div><% } %>
        </div>

        <div class="a4-field" style="grid-column: 1 / span 16;">
          <label class="a4-field-label" for="f-to">
            เรียน <span class="a4-required">*</span>
          </label>
          <input class="a4-input" type="text" id="f-to" name="values[to]" maxlength="200" required value="<%= draft.values.to || '' %>">
          <% if (errs.to) { %><div class="a4-field-error"><%= errs.to %></div><% } %>
        </div>

        <div class="a4-field" style="grid-column: 1 / span 24;">
          <div class="a4-checkbox-row">
            <% var selectedPurpose = draft.values.purpose || []; %>
            <% ['เพื่อทราบ', 'เพื่อดำเนินการ', 'เพื่อบันทึก', 'เพื่อการอนุมัติของท่าน', 'อื่น ๆ'].forEach(function (opt) { %>
              <label>
                <input type="checkbox" name="values[purpose][]" value="<%= opt %>" <%= selectedPurpose.includes(opt) ? 'checked' : '' %>>
                <%= opt %>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="a4-field" style="grid-column: 1 / span 24;">
          <h3 class="a4-static-heading">รายละเอียด <span class="a4-required">*</span></h3>
        </div>

        <div class="a4-field" style="grid-column: 1 / span 24;">
          <textarea class="a4-input" id="f-details" name="values[details]" rows="8" maxlength="5000" required><%= draft.values.details || '' %></textarea>
          <% if (errs.details) { %><div class="a4-field-error"><%= errs.details %></div><% } %>
        </div>

      </div>

      <div class="a4-page-number">หน้า 1</div>
    </div>
  </div>
  </form>

  <script src="/js/autosave.js"></script>
</body>
</html>